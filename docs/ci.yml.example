name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    name: tests (python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip

      - name: Install
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev]"

      - name: Test
        run: python -m pytest tests/ -q --durations=10

  lint:
    name: lint and types
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev]"

      - name: Ruff
        run: ruff check src tests scripts

      - name: Ruff format
        run: ruff format --check src tests scripts

      - name: Mypy
        run: mypy

  experiments:
    name: experiments (smoke)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev]"

      # The quick mode shrinks every experiment to a smoke test: it checks that
      # the scripts run end to end and write parseable output, not that the
      # measured exponents agree with the theory, which needs the full run.
      - name: Run all experiments in quick mode
        run: python scripts/run_all.py --quick --output-dir results-ci

      - name: Check the summary was produced
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          summary = json.loads(Path("results-ci/summary.json").read_text())
          claims = summary["claims"]
          assert claims, "no claims were collected"
          for name, claim in claims.items():
              print(f"{name}: verdict={claim.get('verdict')}")
          PY

      - uses: actions/upload-artifact@v4
        with:
          name: experiment-output
          path: results-ci/